{
  "name": "guild-go-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "check": "vue-tsc --noEmit && eslint . && prettier . --check",
    "dev": "vite",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lucide/vue": "^1.28.0",
    "naive-ui": "^2.45.3",
    "stream-diffs": "^0.0.2",
    "three": "^0.186.1",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@so1ve/eslint-config": "^4.7.0",
    "@so1ve/prettier-config": "^4.7.0",
    "@types/node": "^22.10.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
