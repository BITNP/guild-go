# 监听地址与对外源
APP_ADDR=:8080
APP_PUBLIC_URL=https://guild.example.com
APP_SECURE_COOKIE=true
APP_SESSION_TIMEOUT=30m

# 外部 PostgreSQL
DATABASE_URL=postgres://guild:replace-me@postgres.example.com:5432/guild?sslmode=require

# Keycloak OIDC（confidential client）
OIDC_ISSUER=https://login.example.com/realms/master
OIDC_CLIENT_ID=guild
OIDC_CLIENT_SECRET=replace-with-client-secret

# 只读 Keycloak Admin API：用于显示其他用户姓名/头像/职务
# 留空则回退为 subject、无头像、无职务；三项必须同时设置
KEYCLOAK_ADMIN_URL=https://login.example.com/admin/realms/master
KEYCLOAK_ADMIN_CLIENT_ID=guild-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-service-account-secret

# 外部 S3 兼容存储：只保留这 4 个变量
# region 固定 us-east-1，path-style 固定开启，见 internal/storage/s3.go
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=guild
S3_ACCESS_KEY=replace-with-access-key
S3_SECRET_KEY=replace-with-secret-key